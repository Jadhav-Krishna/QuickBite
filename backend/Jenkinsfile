pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-openjdk-amd64'
        PATH = "${JAVA_HOME}/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"
        
        GIT_REPO = 'https://github.com/Jadhav-Krishna/QuickBite.git'
        GIT_BRANCH = 'dev'
        GIT_CREDENTIALS = 'github-credentials'
        
        DOCKERHUB_USERNAME = credentials('dockerhub-username')
        DOCKERHUB_TOKEN = credentials('dockerhub-token')
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        
        SONAR_HOST_URL = 'http://localhost:9000'
        SONAR_TOKEN = credentials('sonarqube-token')
        SONAR_PROJECT_KEY = 'quickbite'
        
        TRIVY_SEVERITY = 'CRITICAL,HIGH'
        TRIVY_TIMEOUT = '10m'
        
        BACKEND_DIR = 'backend'
        FRONTEND_DIR = 'frontend'
    }

    stages {
        stage('Clone Repository') {
            steps {
                echo '========== Cloning Git Repository =========='
                cleanWs()
                git branch: "${GIT_BRANCH}",
                    credentialsId: "${GIT_CREDENTIALS}",
                    url: "${GIT_REPO}"
                
                sh 'git log -1'
                sh 'ls -la'
            }
        }

        stage('Environment Setup') {
            steps {
                echo '========== Setting Up Environment =========='
                script {
                    sh '''
                        echo "Java Version:"
                        java -version
                        
                        echo "Maven Version:"
                        mvn -version || echo "Maven will be downloaded by Maven Wrapper"
                        
                        echo "Docker Version:"
                        docker --version
                        
                        echo "Trivy Version:"
                        trivy --version || echo "Trivy not installed - will skip security scans"
                        
                        echo "Node Version:"
                        node --version || echo "Node not installed"
                    '''
                }
            }
        }

        stage('Backend - Build JAR Files') {
            steps {
                echo '========== Building JAR Files for All Services =========='
                dir("${BACKEND_DIR}") {
                    script {
                        def services = [
                            'eureka-server',
                            'admin-server',
                            'quickbite-gateway',
                            'auth-service',
                            'restaurant-service',
                            'menu-service',
                            'cart-service',
                            'order-service',
                            'payment-service',
                            'delivery-service',
                            'review-service',
                            'notification-service'
                        ]
                        
                        for (String service : services) {
                            echo "Building JAR for ${service}..."
                            sh """
                                cd ${service}
                                if [ -f "../mvnw" ]; then
                                    chmod +x ../mvnw
                                    ../mvnw clean package -DskipTests
                                else
                                    mvn clean package -DskipTests
                                fi
                                
                                echo "Verifying JAR for ${service}..."
                                ls -lh target/*.jar 2>/dev/null | grep -v original || echo "JAR created"
                            """
                        }
                        
                        echo "All JAR files built successfully!"
                        sh 'find . -name "*.jar" -type f | grep -v original'
                    }
                }
            }
        }

        stage('Backend - Unit Tests') {
            steps {
                echo '========== Running Backend Unit Tests =========='
                dir("${BACKEND_DIR}") {
                    script {
                        def services = [
                            'eureka-server',
                            'admin-server',
                            'quickbite-gateway',
                            'auth-service',
                            'restaurant-service',
                            'menu-service',
                            'cart-service',
                            'order-service',
                            'payment-service',
                            'delivery-service',
                            'review-service',
                            'notification-service'
                        ]
                        
                        def failedTests = []
                        
                        for (String service : services) {
                            try {
                                echo "Running tests for ${service}..."
                                sh """
                                    cd ${service}
                                    if [ -f "../mvnw" ]; then
                                        ../mvnw test
                                    else
                                        mvn test
                                    fi
                                """
                                echo "Tests passed for ${service}"
                            } catch (Exception e) {
                                echo "Tests failed for ${service}: ${e.message}"
                                failedTests.add(service)
                            }
                        }
                        
                        if (failedTests.size() > 0) {
                            echo "WARNING: Tests failed for: ${failedTests.join(', ')}"
                            echo "Continuing pipeline..."
                        } else {
                            echo "All backend tests passed successfully!"
                        }
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${BACKEND_DIR}/**/target/surefire-reports/*.xml"
                }
            }
        }

        stage('Backend - SonarQube Analysis') {
            steps {
                echo '========== Running SonarQube Code Quality Analysis =========='
                script {
                    withSonarQubeEnv('SonarQube') {
                        dir("${BACKEND_DIR}") {
                            try {
                                sh """
                                    echo "Starting SonarQube analysis..."
                                    if [ -f "./mvnw" ]; then
                                        ./mvnw clean verify sonar:sonar \
                                          -Dsonar.projectKey=${SONAR_PROJECT_KEY}-backend \
                                          -Dsonar.projectName=QuickBite-Backend \
                                          -Dsonar.coverage.jacoco.xmlReportPaths=**/target/site/jacoco/jacoco.xml \
                                          -Dsonar.java.coveragePlugin=jacoco
                                    else
                                        mvn clean verify sonar:sonar \
                                          -Dsonar.projectKey=${SONAR_PROJECT_KEY}-backend \
                                          -Dsonar.projectName=QuickBite-Backend \
                                          -Dsonar.coverage.jacoco.xmlReportPaths=**/target/site/jacoco/jacoco.xml \
                                          -Dsonar.java.coveragePlugin=jacoco
                                    fi
                                    echo "Backend SonarQube analysis completed!"
                                """
                            } catch (Exception e) {
                                echo "Backend SonarQube analysis failed: ${e.message}"
                                echo "Continuing pipeline..."
                            }
                        }
                    }
                }
            }
        }

        stage('Frontend - SonarQube Analysis') {
            steps {
                echo '========== Running Frontend SonarQube Analysis =========='
                script {
                    withSonarQubeEnv('SonarQube') {
                        dir("${FRONTEND_DIR}") {
                            try {
                                sh '''
                                    echo "Generating test coverage..."
                                    npm run test:coverage || npm run test -- --coverage
                                    
                                    echo "Starting Frontend SonarQube analysis..."
                                    npx sonar-scanner \
                                      -Dsonar.projectKey=quickbite-frontend \
                                      -Dsonar.projectName=QuickBite-Frontend \
                                      -Dsonar.sources=src \
                                      -Dsonar.tests=src \
                                      -Dsonar.test.inclusions=**/*.test.ts,**/*.test.tsx,**/*.spec.ts,**/*.spec.tsx \
                                      -Dsonar.exclusions=**/*.test.ts,**/*.test.tsx,**/*.spec.ts,**/*.spec.tsx,**/node_modules/**,**/dist/**,**/coverage/** \
                                      -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                                      -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info
                                    
                                    echo "Frontend SonarQube analysis completed!"
                                '''
                            } catch (Exception e) {
                                echo "Frontend SonarQube analysis failed: ${e.message}"
                                echo "Continuing pipeline..."
                            }
                        }
                    }
                }
            }
        }

        stage('Backend - Quality Gate') {
            steps {
                echo '========== Checking SonarQube Quality Gate =========='
                script {
                    try {
                        timeout(time: 5, unit: 'MINUTES') {
                            def qg = waitForQualityGate()
                            if (qg.status != 'OK') {
                                echo "Quality Gate Status: ${qg.status}"
                                echo "WARNING: Quality Gate failed but continuing pipeline..."
                            } else {
                                echo "Quality Gate PASSED!"
                            }
                        }
                    } catch (Exception e) {
                        echo "Quality Gate check failed: ${e.message}"
                        echo "Continuing pipeline..."
                    }
                }
            }
        }

        stage('Frontend - Install Dependencies') {
            steps {
                echo '========== Installing Frontend Dependencies =========='
                dir("${FRONTEND_DIR}") {
                    script {
                        try {
                            sh '''
                                echo "Node version:"
                                node --version
                                echo "NPM version:"
                                npm --version
                                
                                echo "Installing dependencies..."
                                npm ci || npm install
                                
                                echo "Dependencies installed successfully!"
                            '''
                        } catch (Exception e) {
                            echo "npm install failed: ${e.message}"
                            error("Frontend dependency installation failed")
                        }
                    }
                }
            }
        }

        stage('Frontend - Tests with Coverage') {
            steps {
                echo '========== Running Frontend Tests with Coverage =========='
                dir("${FRONTEND_DIR}") {
                    script {
                        try {
                            sh '''
                                echo "Running Vitest tests with coverage..."
                                npm run test:coverage || npm run test -- --coverage
                                
                                echo "Coverage report generated!"
                                ls -la coverage/ || echo "Coverage directory not found"
                                
                                echo "Frontend tests completed successfully!"
                            '''
                        } catch (Exception e) {
                            echo "Frontend tests failed: ${e.message}"
                            echo "Continuing pipeline..."
                        }
                    }
                }
            }
            post {
                always {
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "${FRONTEND_DIR}/coverage",
                        reportFiles: 'index.html',
                        reportName: 'Frontend Coverage Report'
                    ])
                }
            }
        }

        stage('Frontend - Build') {
            steps {
                echo '========== Building Frontend Application =========='
                dir("${FRONTEND_DIR}") {
                    script {
                        try {
                            sh '''
                                echo "Building frontend..."
                                npm run build
                                
                                echo "Verifying build output..."
                                ls -lh dist/ || echo "Build output not found"
                                
                                echo "Frontend build completed successfully!"
                            '''
                        } catch (Exception e) {
                            echo "Frontend build failed: ${e.message}"
                            error("Frontend build failed")
                        }
                    }
                }
            }
        }

        stage('Docker - Cleanup') {
            steps {
                echo '========== Cleaning Up Docker Resources =========='
                script {
                    sh '''
                        echo "Current disk usage:"
                        df -h
                        
                        echo "Removing unused Docker resources..."
                        docker system prune -af --volumes || true
                        
                        echo "Removing old images..."
                        docker images | grep "${DOCKERHUB_USERNAME}" | awk '{print $3}' | xargs -r docker rmi -f || true
                        
                        echo "After cleanup:"
                        df -h
                        docker system df
                    '''
                }
            }
        }

        stage('Docker - Login') {
            steps {
                echo '========== Logging into Docker Hub =========='
                sh 'echo $DOCKERHUB_TOKEN | docker login -u $DOCKERHUB_USERNAME --password-stdin'
            }
        }

        stage('Docker - Build Images') {
            steps {
                echo '========== Building Docker Images =========='
                dir("${BACKEND_DIR}") {
                    script {
                        def services = [
                            'eureka-server',
                            'admin-server',
                            'quickbite-gateway',
                            'auth-service',
                            'restaurant-service',
                            'menu-service',
                            'cart-service',
                            'order-service',
                            'payment-service',
                            'delivery-service',
                            'review-service',
                            'notification-service'
                        ]
                        
                        for (String service : services) {
                            echo "Building ${service}:${IMAGE_TAG}..."
                            sh """
                                docker build \
                                  -t \${DOCKERHUB_USERNAME}/${service}:${IMAGE_TAG} \
                                  -t \${DOCKERHUB_USERNAME}/${service}:latest \
                                  ./${service}
                            """
                        }
                    }
                }
            }
        }

        stage('Trivy - Scan Docker Images') {
            steps {
                echo '========== Scanning Docker Images with Trivy =========='
                script {
                    def services = [
                        'eureka-server',
                        'admin-server',
                        'quickbite-gateway',
                        'auth-service',
                        'restaurant-service',
                        'menu-service',
                        'cart-service',
                        'order-service',
                        'payment-service',
                        'delivery-service',
                        'review-service',
                        'notification-service'
                    ]
                    
                    for (String service : services) {
                        echo "Scanning ${service}..."
                        sh """
                            trivy image \
                              --severity ${TRIVY_SEVERITY} \
                              --timeout ${TRIVY_TIMEOUT} \
                              --exit-code 0 \
                              --format table \
                              \${DOCKERHUB_USERNAME}/${service}:${IMAGE_TAG} \
                              > trivy-report-${service}.txt || true
                        """
                        
                        sh """
                            trivy image \
                              --severity ${TRIVY_SEVERITY} \
                              --timeout ${TRIVY_TIMEOUT} \
                              --exit-code 0 \
                              --format json \
                              --output trivy-report-${service}.json \
                              \${DOCKERHUB_USERNAME}/${service}:${IMAGE_TAG} || true
                        """
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report-*.txt', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'trivy-report-*.json', allowEmptyArchive: true
                }
            }
        }

        stage('Docker - Push Images') {
            steps {
                echo '========== Pushing Docker Images to Registry =========='
                script {
                    def services = [
                        'eureka-server',
                        'admin-server',
                        'quickbite-gateway',
                        'auth-service',
                        'restaurant-service',
                        'menu-service',
                        'cart-service',
                        'order-service',
                        'payment-service',
                        'delivery-service',
                        'review-service',
                        'notification-service'
                    ]
                    
                    for (String service : services) {
                        echo "Pushing ${service}..."
                        sh """
                            docker push \${DOCKERHUB_USERNAME}/${service}:${IMAGE_TAG}
                            docker push \${DOCKERHUB_USERNAME}/${service}:latest
                        """
                    }
                }
            }
        }

        stage('Setup Environment File') {
            steps {
                echo '========== Creating .env File =========='
                dir("${BACKEND_DIR}") {
                    script {
                        withCredentials([
                            string(credentialsId: 'mysql-root-password', variable: 'MYSQL_ROOT_PASSWORD'),
                            string(credentialsId: 'mysql-password', variable: 'MYSQL_PASSWORD'),
                            string(credentialsId: 'jwt-secret', variable: 'JWT_SECRET'),
                            string(credentialsId: 'google-client-id', variable: 'GOOGLE_CLIENT_ID'),
                            string(credentialsId: 'google-client-secret', variable: 'GOOGLE_CLIENT_SECRET'),
                            string(credentialsId: 'github-client-id', variable: 'GITHUB_CLIENT_ID'),
                            string(credentialsId: 'github-client-secret', variable: 'GITHUB_CLIENT_SECRET'),
                            string(credentialsId: 'razorpay-key-id', variable: 'RAZORPAY_KEY_ID'),
                            string(credentialsId: 'razorpay-key-secret', variable: 'RAZORPAY_KEY_SECRET'),
                            string(credentialsId: 'mail-username', variable: 'MAIL_USERNAME'),
                            string(credentialsId: 'mail-password', variable: 'MAIL_PASSWORD'),
                            string(credentialsId: 'twilio-account-sid', variable: 'TWILIO_ACCOUNT_SID'),
                            string(credentialsId: 'twilio-auth-token', variable: 'TWILIO_AUTH_TOKEN'),
                            string(credentialsId: 'twilio-from-phone', variable: 'TWILIO_FROM_PHONE'),
                            string(credentialsId: 'locationiq-api-key', variable: 'LOCATIONIQ_API_KEY'),
                            string(credentialsId: 'cloudinary-cloud-name', variable: 'CLOUDINARY_CLOUD_NAME'),
                            string(credentialsId: 'cloudinary-api-key', variable: 'CLOUDINARY_API_KEY'),
                            string(credentialsId: 'cloudinary-api-secret', variable: 'CLOUDINARY_API_SECRET')
                        ]) {
                            sh '''
                                cat > .env << EOF
DOCKERHUB_USERNAME=${DOCKERHUB_USERNAME}
DOCKERHUB_REPOSITORY=quickbite
IMAGE_TAG=latest
DOCKER_USERNAME=${DOCKERHUB_USERNAME}

MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
MYSQL_USER=quickbite
MYSQL_PASSWORD=${MYSQL_PASSWORD}
MYSQL_PORT=3306

DB_HOST=mysql
DB_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ZOOKEEPER_PORT=2181

EUREKA_HOST=eureka-server
EUREKA_PORT=8761
EUREKA_URL=http://eureka-server:8761/eureka/

GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
RESTAURANT_SERVICE_PORT=8002
MENU_SERVICE_PORT=8003
CART_SERVICE_PORT=8004
ORDER_SERVICE_PORT=8005
PAYMENT_SERVICE_PORT=8006
DELIVERY_SERVICE_PORT=8007
REVIEW_SERVICE_PORT=8008
NOTIFICATION_SERVICE_PORT=8009
ADMIN_SERVER_PORT=8762
ADMIN_BASE_URL=http://admin-server:8762

JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}

RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET}

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM=${MAIL_USERNAME}

TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_FROM_PHONE=${TWILIO_FROM_PHONE}

LOCATIONIQ_API_KEY=${LOCATIONIQ_API_KEY}

CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET}

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080

JAVA_OPTS=-Xmx512m
EOF
                                echo ".env file created successfully"
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy - Infrastructure') {
            steps {
                echo '========== Deploying Infrastructure Services =========='
                dir("${BACKEND_DIR}") {
                    sh '''
                        docker compose down || true
                        
                        docker compose up -d mysql redis rabbitmq zookeeper kafka
                        
                        echo "Waiting for infrastructure services to be healthy..."
                        sleep 60
                        
                        docker compose ps
                    '''
                }
            }
        }

        stage('Deploy - Application Services') {
            steps {
                echo '========== Deploying Application Services =========='
                dir("${BACKEND_DIR}") {
                    sh '''
                        docker compose up -d eureka-server
                        echo "Waiting for Eureka Server..."
                        sleep 45
                        
                        docker compose up -d
                        
                        echo "Waiting for all services to be ready..."
                        sleep 120
                        
                        docker compose ps
                        docker ps
                        
                        echo "Checking container logs for errors..."
                        docker compose logs --tail=50 || true
                    '''
                }
            }
        }

        stage('Health Checks') {
            steps {
                echo '========== Performing Health Checks =========='
                script {
                    sh 'sleep 30'
                    
                    def services = [
                        [name: 'Eureka Server', url: 'http://localhost:8761/actuator/health'],
                        [name: 'Gateway', url: 'http://localhost:8000/actuator/health'],
                        [name: 'Auth Service', url: 'http://localhost:8001/actuator/health'],
                        [name: 'Restaurant Service', url: 'http://localhost:8002/actuator/health'],
                        [name: 'Menu Service', url: 'http://localhost:8003/actuator/health'],
                        [name: 'Cart Service', url: 'http://localhost:8004/actuator/health'],
                        [name: 'Order Service', url: 'http://localhost:8005/actuator/health'],
                        [name: 'Payment Service', url: 'http://localhost:8006/actuator/health'],
                        [name: 'Delivery Service', url: 'http://localhost:8007/actuator/health'],
                        [name: 'Review Service', url: 'http://localhost:8008/actuator/health'],
                        [name: 'Notification Service', url: 'http://localhost:8009/actuator/health']
                    ]
                    
                    def healthyServices = 0
                    def totalServices = services.size()
                    
                    for (service in services) {
                        try {
                            def response = sh(
                                script: "curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 ${service.url} || echo 'failed'",
                                returnStdout: true
                            ).trim()
                            
                            if (response == '200') {
                                echo "${service.name} is HEALTHY"
                                healthyServices++
                            } else {
                                echo "${service.name} returned: ${response}"
                            }
                        } catch (Exception e) {
                            echo "${service.name} FAILED: ${e.message}"
                        }
                    }
                    
                    echo "=========================================="
                    echo "Health Check: ${healthyServices}/${totalServices} services healthy"
                    echo "=========================================="
                    
                    if (healthyServices == 0) {
                        echo "ERROR: No services are healthy! Check logs."
                    } else if (healthyServices < totalServices * 0.5) {
                        echo "WARNING: Less than 50% of services are healthy!"
                    }
                }
            }
        }

        stage('Smoke Tests') {
            steps {
                echo '========== Running Smoke Tests =========='
                script {
                    sh '''
                        # Test Gateway routing
                        echo "Testing Gateway..."
                        curl -f http://localhost:8000/actuator/health || echo "Gateway test failed"
                        
                        # Test Auth Service
                        echo "Testing Auth Service..."
                        curl -f http://localhost:8000/api/auth/health || echo "Auth service test failed"
                        
                        # Test Restaurant Service
                        echo "Testing Restaurant Service..."
                        curl -f http://localhost:8000/api/restaurants/health || echo "Restaurant service test failed"
                        
                        echo "Smoke tests completed!"
                    '''
                }
            }
        }
    }

    post {
        always {
            echo '========== Pipeline Cleanup =========='
            script {
                sh 'docker logout || true'
                
                archiveArtifacts artifacts: "${BACKEND_DIR}/**/target/surefire-reports/**/*.xml", allowEmptyArchive: true
                archiveArtifacts artifacts: 'trivy-report-*.txt', allowEmptyArchive: true
                archiveArtifacts artifacts: 'trivy-report-*.json', allowEmptyArchive: true
            }
        }
        
        success {
            echo '=========================================='
            echo ' PIPELINE SUCCEEDED!'
            echo '=========================================='
            echo "Build Number: ${IMAGE_TAG}"
            echo "Docker Images: ${DOCKERHUB_USERNAME}/*:${IMAGE_TAG}"
            echo ''
            echo 'Application URLs:'
            echo '  - Gateway: http://localhost:8000'
            echo '  - Eureka: http://localhost:8761'
            echo '  - Admin: http://localhost:8762'
            echo '  - RabbitMQ: http://localhost:15672'
            echo '=========================================='
            
            // Send success notification (optional)
            // emailext subject: "✓ QuickBite Build #${BUILD_NUMBER} - SUCCESS",
            //          body: "Build completed successfully. Images tagged: ${IMAGE_TAG}",
            //          to: "team@example.com"
        }
        
        failure {
            echo '=========================================='
            echo 'PIPELINE FAILED!'
            echo '=========================================='
            
            script {
                sh '''
                    echo "Container Status:"
                    docker ps -a || echo "Could not run docker ps -a (check permissions)"
                    
                    echo "Gateway Logs:"
                    docker logs quickbite-gateway --tail 100 || echo "Could not fetch Gateway logs"
                    
                    echo "Eureka Logs:"
                    docker logs quickbite-eureka-server --tail 100 || echo "Could not fetch Eureka logs"
                '''
            }
            
        }
        
        unstable {
            echo '=========================================='
            echo 'PIPELINE UNSTABLE'
            echo '=========================================='
            echo 'Some tests may have failed. Check reports.'
        }
    }
}