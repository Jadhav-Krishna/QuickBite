pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK 21'
    }

    environment {
        // Git Repository
        GIT_REPO = 'https://github.com/Jadhav-Krishna/QuickBite.git'
        GIT_BRANCH = 'dev'
        GIT_CREDENTIALS = 'github-credentials'
        
        // Docker Configuration
        DOCKERHUB_USERNAME = credentials('dockerhub-username')
        DOCKERHUB_TOKEN = credentials('dockerhub-token')
        DOCKER_REGISTRY = 'docker.io'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        
        // SonarQube Configuration
        SONAR_HOST_URL = 'http://sonarqube:9000'
        SONAR_TOKEN = credentials('sonarqube-token')
        SONAR_PROJECT_KEY = 'quickbite'
        
        // Trivy Configuration
        TRIVY_SEVERITY = 'CRITICAL,HIGH'
        TRIVY_TIMEOUT = '10m'
        
        // Application Configuration
        BACKEND_DIR = 'backend'
        FRONTEND_DIR = 'frontend'
    }

    stages {
        stage('Clone Repository') {
            steps {
                echo '========== Cloning Git Repository =========='
                cleanWs()
                git branch: "${GIT_BRANCH}",
                    credentialsId: "${GIT_CREDENTIALS}",
                    url: "${GIT_REPO}"
                
                sh 'git log -1'
                sh 'ls -la'
            }
        }

        stage('Environment Setup') {
            steps {
                echo '========== Setting Up Environment =========='
                script {
                    sh '''
                        echo "Java Version:"
                        java -version
                        
                        echo "Maven Version:"
                        mvn -version
                        
                        echo "Docker Version:"
                        docker --version
                        
                        echo "Trivy Version:"
                        trivy --version || echo "Trivy not installed"
                    '''
                }
            }
        }

        stage('Backend - Build') {
            steps {
                echo '========== Building Backend Microservices =========='
                dir("${BACKEND_DIR}") {
                    sh 'mvn clean compile -DskipTests'
                }
            }
        }

        stage('Backend - Unit Tests') {
            steps {
                echo '========== Running Backend Unit Tests =========='
                dir("${BACKEND_DIR}") {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${BACKEND_DIR}/**/target/surefire-reports/*.xml"
                    jacoco(
                        execPattern: "${BACKEND_DIR}/**/target/jacoco.exec",
                        classPattern: "${BACKEND_DIR}/**/target/classes",
                        sourcePattern: "${BACKEND_DIR}/**/src/main/java"
                    )
                }
            }
        }

        stage('Backend - Integration Tests') {
            steps {
                echo '========== Running Backend Integration Tests =========='
                dir("${BACKEND_DIR}") {
                    sh 'mvn verify -DskipUnitTests'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${BACKEND_DIR}/**/target/failsafe-reports/*.xml"
                }
            }
        }

        stage('Backend - SonarQube Analysis') {
            steps {
                echo '========== Running SonarQube Code Quality Analysis =========='
                dir("${BACKEND_DIR}") {
                    script {
                        try {
                            withSonarQubeEnv('SonarQube') {
                                sh """
                                    mvn sonar:sonar \
                                      -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                      -Dsonar.projectName=QuickBite-Backend \
                                      -Dsonar.host.url=${SONAR_HOST_URL} \
                                      -Dsonar.login=${SONAR_TOKEN} \
                                      -Dsonar.java.coveragePlugin=jacoco \
                                      -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                                      -Dsonar.exclusions=**/target/**,**/test/**
                                """
                            }
                        } catch (Exception e) {
                            echo "SonarQube analysis failed: ${e.message}"
                            echo "Continuing pipeline..."
                        }
                    }
                }
            }
        }

        stage('Backend - Quality Gate') {
            steps {
                echo '========== Checking SonarQube Quality Gate =========='
                script {
                    try {
                        timeout(time: 5, unit: 'MINUTES') {
                            def qg = waitForQualityGate()
                            if (qg.status != 'OK') {
                                echo "Quality Gate Status: ${qg.status}"
                                echo "WARNING: Quality Gate failed but continuing pipeline..."
                            } else {
                                echo "Quality Gate PASSED!"
                            }
                        }
                    } catch (Exception e) {
                        echo "Quality Gate check failed: ${e.message}"
                        echo "Continuing pipeline..."
                    }
                }
            }
        }

        stage('Backend - Package') {
            steps {
                echo '========== Packaging Backend Applications =========='
                dir("${BACKEND_DIR}") {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Frontend - Install Dependencies') {
            steps {
                echo '========== Installing Frontend Dependencies =========='
                dir("${FRONTEND_DIR}") {
                    sh 'npm install'
                }
            }
        }

        stage('Frontend - Build') {
            steps {
                echo '========== Building Frontend Application =========='
                dir("${FRONTEND_DIR}") {
                    sh 'npm run build'
                }
            }
        }

        stage('Frontend - Tests') {
            steps {
                echo '========== Running Frontend Tests =========='
                dir("${FRONTEND_DIR}") {
                    sh 'npm run test -- --run || true'
                }
            }
        }

        stage('Docker - Login') {
            steps {
                echo '========== Logging into Docker Hub =========='
                sh 'echo $DOCKERHUB_TOKEN | docker login -u $DOCKERHUB_USERNAME --password-stdin'
            }
        }

        stage('Docker - Build Images') {
            steps {
                echo '========== Building Docker Images =========='
                dir("${BACKEND_DIR}") {
                    script {
                        def services = [
                            'eureka-server',
                            'admin-server',
                            'quickbite-gateway',
                            'auth-service',
                            'restaurant-service',
                            'menu-service',
                            'cart-service',
                            'order-service',
                            'payment-service',
                            'delivery-service',
                            'review-service',
                            'notification-service'
                        ]
                        
                        for (String service : services) {
                            echo "Building ${service}:${IMAGE_TAG}..."
                            sh """
                                docker build \
                                  -t ${DOCKERHUB_USERNAME}/${service}:${IMAGE_TAG} \
                                  -t ${DOCKERHUB_USERNAME}/${service}:latest \
                                  ./${service}
                            """
                        }
                    }
                }
            }
        }

        stage('Trivy - Scan Docker Images') {
            steps {
                echo '========== Scanning Docker Images with Trivy =========='
                script {
                    def services = [
                        'eureka-server',
                        'admin-server',
                        'quickbite-gateway',
                        'auth-service',
                        'restaurant-service',
                        'menu-service',
                        'cart-service',
                        'order-service',
                        'payment-service',
                        'delivery-service',
                        'review-service',
                        'notification-service'
                    ]
                    
                    for (String service : services) {
                        echo "Scanning ${service}..."
                        sh """
                            trivy image \
                              --severity ${TRIVY_SEVERITY} \
                              --timeout ${TRIVY_TIMEOUT} \
                              --exit-code 0 \
                              --format table \
                              ${DOCKERHUB_USERNAME}/${service}:${IMAGE_TAG} \
                              > trivy-report-${service}.txt || true
                        """
                        
                        // Generate JSON report for archiving
                        sh """
                            trivy image \
                              --severity ${TRIVY_SEVERITY} \
                              --timeout ${TRIVY_TIMEOUT} \
                              --exit-code 0 \
                              --format json \
                              --output trivy-report-${service}.json \
                              ${DOCKERHUB_USERNAME}/${service}:${IMAGE_TAG} || true
                        """
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report-*.txt', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'trivy-report-*.json', allowEmptyArchive: true
                }
            }
        }

        stage('Docker - Push Images') {
            steps {
                echo '========== Pushing Docker Images to Registry =========='
                script {
                    def services = [
                        'eureka-server',
                        'admin-server',
                        'quickbite-gateway',
                        'auth-service',
                        'restaurant-service',
                        'menu-service',
                        'cart-service',
                        'order-service',
                        'payment-service',
                        'delivery-service',
                        'review-service',
                        'notification-service'
                    ]
                    
                    for (String service : services) {
                        echo "Pushing ${service}..."
                        sh """
                            docker push ${DOCKERHUB_USERNAME}/${service}:${IMAGE_TAG}
                            docker push ${DOCKERHUB_USERNAME}/${service}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy - Infrastructure') {
            steps {
                echo '========== Deploying Infrastructure Services =========='
                dir("${BACKEND_DIR}") {
                    sh '''
                        # Stop existing containers
                        docker-compose down || true
                        
                        # Start infrastructure services first
                        docker-compose up -d mysql redis rabbitmq zookeeper kafka
                        
                        # Wait for infrastructure to be ready
                        echo "Waiting for infrastructure services to be healthy..."
                        sleep 60
                        
                        # Check infrastructure health
                        docker-compose ps
                    '''
                }
            }
        }

        stage('Deploy - Application Services') {
            steps {
                echo '========== Deploying Application Services =========='
                dir("${BACKEND_DIR}") {
                    sh '''
                        # Start Eureka Server first
                        docker-compose up -d eureka-server
                        echo "Waiting for Eureka Server..."
                        sleep 30
                        
                        # Start remaining services
                        docker-compose up -d
                        
                        # Wait for all services to start
                        echo "Waiting for all services to be ready..."
                        sleep 60
                        
                        # Show running containers
                        docker-compose ps
                        docker ps
                    '''
                }
            }
        }

        stage('Health Checks') {
            steps {
                echo '========== Performing Health Checks =========='
                script {
                    def services = [
                        [name: 'Eureka Server', url: 'http://localhost:8761/actuator/health', port: 8761],
                        [name: 'Gateway', url: 'http://localhost:8000/actuator/health', port: 8000],
                        [name: 'Auth Service', url: 'http://localhost:8001/actuator/health', port: 8001],
                        [name: 'Restaurant Service', url: 'http://localhost:8002/actuator/health', port: 8002],
                        [name: 'Menu Service', url: 'http://localhost:8003/actuator/health', port: 8003],
                        [name: 'Cart Service', url: 'http://localhost:8004/actuator/health', port: 8004],
                        [name: 'Order Service', url: 'http://localhost:8005/actuator/health', port: 8005],
                        [name: 'Payment Service', url: 'http://localhost:8006/actuator/health', port: 8006],
                        [name: 'Delivery Service', url: 'http://localhost:8007/actuator/health', port: 8007],
                        [name: 'Review Service', url: 'http://localhost:8008/actuator/health', port: 8008],
                        [name: 'Notification Service', url: 'http://localhost:8009/actuator/health', port: 8009]
                    ]
                    
                    def healthyServices = 0
                    def totalServices = services.size()
                    
                    for (service in services) {
                        try {
                            def response = sh(
                                script: "curl -s -o /dev/null -w '%{http_code}' ${service.url}",
                                returnStdout: true
                            ).trim()
                            
                            if (response == '200') {
                                echo "${service.name} is HEALTHY"
                                healthyServices++
                            } else {
                                echo "${service.name} returned status: ${response}"
                            }
                        } catch (Exception e) {
                            echo "${service.name} health check FAILED: ${e.message}"
                        }
                    }
                    
                    echo "=========================================="
                    echo "Health Check Summary: ${healthyServices}/${totalServices} services healthy"
                    echo "=========================================="
                    
                    if (healthyServices < totalServices * 0.8) {
                        echo "WARNING: Less than 80% of services are healthy!"
                    }
                }
            }
        }

        stage('Smoke Tests') {
            steps {
                echo '========== Running Smoke Tests =========='
                script {
                    sh '''
                        # Test Gateway routing
                        echo "Testing Gateway..."
                        curl -f http://localhost:8000/actuator/health || echo "Gateway test failed"
                        
                        # Test Auth Service
                        echo "Testing Auth Service..."
                        curl -f http://localhost:8000/api/auth/health || echo "Auth service test failed"
                        
                        # Test Restaurant Service
                        echo "Testing Restaurant Service..."
                        curl -f http://localhost:8000/api/restaurants/health || echo "Restaurant service test failed"
                        
                        echo "Smoke tests completed!"
                    '''
                }
            }
        }
    }

    post {
        always {
            echo '========== Pipeline Cleanup =========='
            script {
                // Logout from Docker
                sh 'docker logout || true'
                
                // Archive artifacts
                archiveArtifacts artifacts: "${BACKEND_DIR}/**/target/surefire-reports/**/*.xml", allowEmptyArchive: true
                archiveArtifacts artifacts: "${BACKEND_DIR}/**/target/failsafe-reports/**/*.xml", allowEmptyArchive: true
                archiveArtifacts artifacts: "${BACKEND_DIR}/**/target/site/jacoco/**/*", allowEmptyArchive: true
                archiveArtifacts artifacts: 'trivy-report-*.txt', allowEmptyArchive: true
                archiveArtifacts artifacts: 'trivy-report-*.json', allowEmptyArchive: true
                
                // Publish test results
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: "${BACKEND_DIR}/target/site/jacoco",
                    reportFiles: 'index.html',
                    reportName: 'JaCoCo Coverage Report'
                ])
            }
        }
        
        success {
            echo '=========================================='
            echo '✓ PIPELINE SUCCEEDED!'
            echo '=========================================='
            echo "Build Number: ${IMAGE_TAG}"
            echo "Docker Images: ${DOCKERHUB_USERNAME}/*:${IMAGE_TAG}"
            echo ''
            echo 'Application URLs:'
            echo '  - Gateway: http://localhost:8000'
            echo '  - Eureka: http://localhost:8761'
            echo '  - Admin: http://localhost:8762'
            echo '  - RabbitMQ: http://localhost:15672'
            echo '=========================================='
            
            // Send success notification (optional)
            // emailext subject: "✓ QuickBite Build #${BUILD_NUMBER} - SUCCESS",
            //          body: "Build completed successfully. Images tagged: ${IMAGE_TAG}",
            //          to: "team@example.com"
        }
        
        failure {
            echo '=========================================='
            echo 'PIPELINE FAILED!'
            echo '=========================================='
            
            script {
                // Show container logs for debugging
                sh '''
                    echo "Container Status:"
                    docker ps -a
                    
                    echo "Gateway Logs:"
                    docker logs quickbite-gateway --tail 100 || true
                    
                    echo "Eureka Logs:"
                    docker logs quickbite-eureka-server --tail 100 || true
                '''
            }
            
            // Send failure notification (optional)
            // emailext subject: "✗ QuickBite Build #${BUILD_NUMBER} - FAILED",
            //          body: "Build failed. Check Jenkins console for details.",
            //          to: "team@example.com"
        }
        
        unstable {
            echo '=========================================='
            echo '⚠ PIPELINE UNSTABLE'
            echo '=========================================='
            echo 'Some tests may have failed. Check reports.'
        }
    }
}
